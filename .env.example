# --- Database (REQUIRED) ---
# Prisma connection string (PostgreSQL/Supabase/etc.)
DATABASE_URL= 
# Used for session cookies
SESSION_SECRET="super-secret-session-key"
WIDGET_SESSION_SECRET="use-a-separate-strong-random-secret"
PARTYKIT_AUTH_SECRET="set-the-same-strong-secret-in-the-app-and-partykit"
# Emergency-only legacy recovery. Keep disabled for normal web runtimes.
AUTO_SCHEMA_SYNC="0"

# --- AI & LlamaStack (REQUIRED) ---
# Gemini API Key
GEMINI_API_KEY= 
VITE_GEMINI_API_KEY= 


# --- Vector Database (REQUIRED for RAG) ---
# Pinecone for storing and querying website embeddings
PINECONE_API_KEY=
PINECONE_INDEX=quickstart
# Pin ONE embedding provider and model for the whole app ("openai" | "gemini")
# Defaulting to "openai" (text-embedding-3-small, 1536 dim). Use "gemini" (text-embedding-004, 768 dim) otherwise.
# IMPORTANT: The Pinecone Index MUST be created with the matching dimension!
EMBEDDING_PROVIDER=openai

# --- AI Gateway & Observability (RECOMMENDED) ---
# Open AI Key (if using GPT models)
OPENAI_API_KEY= 

VITE_OPENAI_API_KEY= 

# Portkey Virtual Key (for model routing/caching)
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=
# Answer quality: set RERANK_ENABLED=true in production (requires Portkey+Cohere keys or RERANK_URL).
RERANK_ENABLED=false
# Reranking: set BOTH PORTKEY_API_KEY and PORTKEY_COHERE_VIRTUAL_KEY to enable Cohere rerank.
PORTKEY_COHERE_VIRTUAL_KEY=
# Cohere rerank model. Defaults to rerank-multilingual-v3.0 (best for multilingual bots).
# Use rerank-english-v3.0 for English-only deployments.
COHERE_RERANK_MODEL=
PORTKEY_MODEL=
PORTKEY_MAX_TOKENS=2048

# --- Web Scraping (REQUIRED for AI Training) ---
# Firecrawl for deep crawling of websites
FIRECRAWL_API_KEY=

# --- Storage (FOR FILE UPLOADS) ---
# Cloudflare R2 or AWS S3
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN="https://pub-...r2.dev"

# --- Analytics & Tracking ---
# PostHog for user behavior analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# --- Security (OPTIONAL) ---
# Cloudflare Turnstile (CAPTCHA)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Payments (FOR BILLING) ---
# Stripe or Paddle

PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT="production" # or "sandbox"

VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_STARTER_PLAN_ID=
VITE_PADDLE_BASIC_PLAN_ID=
VITE_PADDLE_PRO_PLAN_ID=
VITE_PADDLE_REMOVE_BRANDING_ADDON_ID=

# Reusable Checkout Config Price IDs
VITE_PADDLE_STARTER_MONTHLY_PRICE_ID=
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=
VITE_PADDLE_ENTERPRISE_MONTHLY_PRICE_ID=
VITE_PADDLE_STARTER_YEARLY_PRICE_ID=
VITE_PADDLE_PRO_YEARLY_PRICE_ID=
VITE_PADDLE_ENTERPRISE_YEARLY_PRICE_ID=

# --- Real-time & Caching (OPTIONAL) ---
# Upstash Redis for magic links fallback and caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Upstash Workflow for background jobs
UPSTASH_WORKFLOW_URL=

PARTYKIT_HOST=

# --- Google Drive Integration ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Crisp Integration ---
CRISP_CLIENT_ID=
CRISP_CLIENT_SECRET=
CRISP_PLUGIN_ID=
CRISP_PLUGIN_KEY=

# --- Intercom Integration ---
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=

# --- YouTube Integration ---
YOUTUBE_API_KEY=

# --- Cron Scheduler (For Weekly Digest) ---
CRON_SECRET=

# --- Founder / super-admin (optional) ---
# Email that always receives OWNER role (platform admin). Leave unset in multi-tenant prod.
FOUNDER_EMAIL=

# --- Webhook Signing Secret (OPTIONAL) ---
WEBHOOK_SECRET="your-random-secret-here"

# --- Zoho Desk Integration (OAuth) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_DESK_URL="https://desk.zoho.com"

# --- Dropbox Integration (OAuth) ---
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# --- Microsoft OneDrive Integration (Azure AD OAuth) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- App hostname / custom domains ---
# Public hostname of this deployment (no scheme). Used to build the default
# CNAME target `custom.<APP_HOSTNAME>` and to recognize platform Host headers.
APP_HOSTNAME=localhost
# Optional override for the hostname customers should CNAME to.
# CUSTOM_DOMAIN_CNAME_TARGET=custom.example.com
# Comma-separated extra platform hosts (preview aliases, apex, etc.)
# APP_HOSTS=www.example.com,app.example.com

# --- Monitoring & Debugging ---
SENTRY_DSN=
AI_DEBUG=


